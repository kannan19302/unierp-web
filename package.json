{
  "name": "@kannan19302/web",
  "version": "0.0.1",
  "private": true,
  "description": "UniERP Web Frontend — Next.js 15",
  "scripts": {
    "dev": "next dev --port 4003",
    "build": "next build",
    "start": "next start --port 4003",
    "lint": "eslint \"app/**/*.{ts,tsx}\" \"src/**/*.{ts,tsx}\"",
    "typecheck": "node --max-old-space-size=8192 ./node_modules/typescript/bin/tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:journeys": "playwright test --project=journeys",
    "test:e2e:all": "playwright test --project=all-e2e",
    "clean": "rimraf .next"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@kannan19302/auth": "^1.0.3",
    "@kannan19302/framework": "^0.1.4",
    "@kannan19302/sdk": "^1.0.3",
    "@kannan19302/shared": "^1.0.5",
    "@kannan19302/ui": "^1.0.15",
    "@tanstack/react-query": "^5.101.1",
    "@types/papaparse": "^5.5.2",
    "@xyflow/react": "^12.11.0",
    "lucide-react": "^0.460.0",
    "next": "^15.1.0",
    "papaparse": "^5.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-grid-layout": "^2.2.3",
    "react-zoom-pan-pinch": "^4.0.3",
    "recharts": "^3.9.0",
    "socket.io-client": "^4.8.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@kannan19302/config": "^1.0.2",
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "2.1.9",
    "rimraf": "^6.0.0",
    "ts-morph": "^28.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
